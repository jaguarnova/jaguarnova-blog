---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi，我是 jaguarnova 👋</h1>
			<p>这里是我的技术博客，两类内容：</p>
			<ul>
				<li>
					<strong>AI Agent · 从零学习</strong> — 我从零开始学 AI Agent 开发的完整记录：概念拆解、动手实现、
					踩坑与反思，跟着学一遍你会知道怎么造一个 Agent
				</li>
				<li>
					<strong>后端 & 区块链 · 技术分享</strong> — 对现有技术与前沿动态的学习分享：API 设计、性能可靠性、
					智能合约、链上数据等
				</li>
			</ul>
			<p>
				去 <a href={`${import.meta.env.BASE_URL}/blog`}>文章列表</a> 看全部内容，
				或 <a href={`${import.meta.env.BASE_URL}/rss.xml`}>订阅 RSS</a>。
			</p>
		</main>
		<Footer />
	</body>
</html>
