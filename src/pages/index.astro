---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi，我是 jaguarnova 👋</h1>
			<p>
				写技术博客，一篇文章解决一个具体问题。目前主要在折腾：
			</p>
			<ul>
				<li><strong>AI Agent</strong> — 工具调用循环、记忆与上下文管理、多智能体编排、MCP 协议</li>
				<li><strong>后端</strong> — API 设计、性能与可靠性工程、踩坑复盘</li>
				<li><strong>区块链</strong> — 智能合约、链上数据分析、安全实践</li>
			</ul>
			<p>
				去 <a href={`${import.meta.env.BASE_URL}/blog`}>文章列表</a> 看全部内容，
				或 <a href={`${import.meta.env.BASE_URL}/rss.xml`}>订阅 RSS</a>。
			</p>
		</main>
		<Footer />
	</body>
</html>
